# Azure OpenAI Configuration
# Get these from Azure Portal > Your OpenAI Resource > Keys and Endpoint

# Your Azure OpenAI endpoint URL
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Your Azure OpenAI API key (Key 1 or Key 2)
AZURE_OPENAI_API_KEY=your-api-key-here

# API version (use latest stable version)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Your deployment name (from Model deployments section)
# Common names: gpt-4, gpt-35-turbo, gpt-4-turbo
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
